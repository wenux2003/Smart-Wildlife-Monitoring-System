{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@wr/shared": ["packages/shared/src/index.ts"],
      "@wr/ui": ["packages/ui/src/index.ts"],
      "@wr/offline": ["packages/offline/src/index.ts"]
    }
  },
  "files": [],
  "references": [
    { "path": "./packages/shared" },
    { "path": "./packages/ui" },
    { "path": "./packages/offline" },
    { "path": "./apps/api" },
    { "path": "./apps/ranger" },
    { "path": "./apps/ops" }
  ]
}
