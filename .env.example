POSTGRES_DB=wildlife
POSTGRES_USER=wildlife
POSTGRES_PASSWORD=wildlife
DATABASE_URL=postgres://wildlife:wildlife@localhost:5432/wildlife
# Neon: replace DATABASE_URL in your private .env with the URL from Neon Connect.
# Keep its TLS parameters (sslmode=require). Never use a VITE_ variable for it.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
API_PORT=3000
RANGER_PORT=5173
OPS_PORT=5174
# Comma-separated browser origins allowed to submit account requests.
APP_ORIGINS=http://localhost:5174,http://localhost:5173
# Account seed (corepack pnpm db:seed). Fill these in your private .env only.
# The single Super Admin (national scope) — passwords must be 12–128 characters.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASSWORD=
# Shared password for the demo Park Manager, Liaison Officer, Ranger and Researcher accounts.
DEMO_ACCOUNT_PASSWORD=
