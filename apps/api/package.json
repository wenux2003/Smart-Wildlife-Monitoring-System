{
  "name": "@wr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "db:check": "node --env-file=../../.env scripts/check-db.mjs",
    "db:migrate": "node --env-file=../../.env scripts/migrate.mjs",
    "db:seed": "tsx --env-file=../../.env src/seed.ts",
    "db:seed:patrols": "tsx --env-file=../../.env src/seed-patrols.ts",
    "db:seed:demo": "tsx --env-file=../../.env src/seed-demo-data.ts",
    "auth:check": "node --env-file=../../.env scripts/check-auth.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:seed:analytics": "tsx --env-file=../../.env src/seed-analytics.ts"
  },
  "dependencies": {
    "fastify-type-provider-zod": "4.0.2",
    "@wr/shared": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "postgres": "^3.4.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.20.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
