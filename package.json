{
  "name": "wana-rakshaka",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "corepack pnpm --filter @wr/api dev",
    "db:check": "corepack pnpm --filter @wr/api db:check",
    "db:migrate": "corepack pnpm --filter @wr/api db:migrate",
    "db:seed": "corepack pnpm --filter @wr/api db:seed",
    "db:seed:patrols": "corepack pnpm --filter @wr/api db:seed:patrols",
    "auth:check": "corepack pnpm --filter @wr/api auth:check",
    "dev:ranger": "corepack pnpm --filter @wr/ranger dev",
    "dev:ops": "corepack pnpm --filter @wr/ops dev",
    "dev:all": "corepack pnpm --parallel --filter @wr/api --filter @wr/ranger --filter @wr/ops dev",
    "build": "corepack pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc -b packages/shared packages/ui packages/offline && corepack pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
