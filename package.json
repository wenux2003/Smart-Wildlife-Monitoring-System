{
  "name": "wana-rakshaka",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @wr/api dev",
    "db:check": "pnpm --filter @wr/api db:check",
    "dev:ranger": "pnpm --filter @wr/ranger dev",
    "dev:ops": "pnpm --filter @wr/ops dev",
    "dev:all": "pnpm --parallel --filter @wr/api --filter @wr/ranger --filter @wr/ops dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
